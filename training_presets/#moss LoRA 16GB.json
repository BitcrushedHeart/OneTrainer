{
    "base_model_name": "OpenMOSS-Team/MOSS-Image-Base",
    "batch_size": 2,
    "learning_rate": 0.0003,
    "model_type": "MOSS",
    "resolution": "512",
    "compile": true,
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_8"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "FLOAT_8"
    },
    "training_method": "LORA",
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "weight_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "layer_filter": "proj.q,proj.k,proj.v,proj.o,proj.ffn_up_gate,proj.ffn_down",
    "layer_filter_preset": "attn-mlp",
    "quantization": {
        "layer_filter": "layers",
        "layer_filter_preset": "blocks"
    },
    "dataloader_threads": 1,
    "timestep_distribution": "LOGIT_NORMAL",
    "noising_bias": 1.09,
    "noising_weight": -0.05,
    "timestep_shift": 1.0,
    "dynamic_timestep_shifting": false
}
